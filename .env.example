# Copy this file to .env and fill in real values for LOCAL development:
#   cp .env.example .env
# The services read it automatically (see config.py in each service).
# Never commit your real .env — it's covered by .gitignore.

# Shared secret from your telematics provider's webhook settings.
# Leave empty to disable signature verification locally.
WEBHOOK_SECRET=

# Where to find Kafka / Redis / Postgres when running on your laptop
# (the docker run commands in the README expose these ports).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=telemetry.raw.events
KAFKA_TOPIC_DLQ=telemetry.dlq
KAFKA_CONSUMER_GROUP=telemetry-processor
REDIS_URL=redis://localhost:6379/0
DB_DSN=postgresql://fleet:fleet@localhost:5432/telemetry

# Batch tuning (see processor/config.py for what these mean).
BATCH_SIZE=500
BATCH_FLUSH_SECONDS=2.0
LOG_LEVEL=INFO
